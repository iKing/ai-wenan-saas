# AI 文案工坊 V3.1 - 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# ==================== 应用配置 ====================
FLASK_ENV=production
SECRET_KEY=你的 flask 会话密钥_随机生成 32 位以上

# ==================== 数据库配置 ====================
DATABASE_PATH=/home/admin/ai-wenan-backend/wenyan.db

# ==================== JWT 配置（必须修改） ====================
# 生成方法：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=你的 JWT 密钥_随机生成 32 位以上_生产环境必须修改

# ==================== AI 模型配置 ====================
AI_MODEL=qwen
DEEPSEEK_API_KEY=你的 DeepSeek API 密钥（可选）

# ==================== 支付配置 ====================
WECHAT_PAY_MCH_ID=微信支付商户号
WECHAT_PAY_KEY=微信支付 API 密钥
ALIPAY_APP_ID=支付宝应用 ID
ALIPAY_PRIVATE_KEY=支付宝私钥
ALIPAY_PUBLIC_KEY=支付宝公钥

# ==================== 管理员配置 ====================
# 首次启动会自动创建 admin 账户，密码打印到日志
# 建议创建后立即修改密码
